{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post", "put"],
      "route": "{*rest}"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "outputBlob",
      "path": "dumps/%DOMAIN_LABEL%/{rand-guid}.raw",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
